#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "L10N-CONV"
msgstr ""

#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "February 2026"
msgstr ""

#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "l10n-conv 1.0.4"
msgstr ""

#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "User Commands"
msgstr ""

#. type: SH
#: data/man/l10n-conv.1:2
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:4
msgid ""
"l10n-conv - universal localization file converter, validator, and compiler"
msgstr ""

#. type: SH
#: data/man/l10n-conv.1:4
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:7
msgid ""
"B<l10n-conv> [I<GLOBAL-OPTIONS>] I<COMMAND> [I<COMMAND-OPTIONS>] [I<ARGS>]"
msgstr ""

#. type: SH
#: data/man/l10n-conv.1:7
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:11
msgid ""
"B<l10n-conv> converts between different localization file formats, validates "
"translation files, compiles them to binary formats, extracts translatable "
"strings from source code, and shows translation statistics."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:15
msgid ""
"Supported formats include PO (gettext), XLIFF, TS (Qt), JSON, YAML, ARB "
"(Flutter/Dart), Properties (Java), Strings (Apple), Android XML, and more."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:18
msgid ""
"Format auto-detection is used when possible; use B<-f>/B<--format> to "
"override."
msgstr ""

#. type: SH
#: data/man/l10n-conv.1:18
#, no-wrap
msgid "GLOBAL OPTIONS"
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:19
#, no-wrap
msgid "B<-j>, B<--json>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:22
msgid "Output results as JSON for all commands."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:22
#, no-wrap
msgid "B<-q>, B<--quiet>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:25
msgid "Suppress non-essential output. Only errors are shown."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:25
#, no-wrap
msgid "B<-v>, B<--verbose>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:28
msgid "Verbose output with progress details."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:28
#, no-wrap
msgid "B<--about>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:31
msgid "Show application info (name, version, author, license) and exit."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:31
#, no-wrap
msgid "B<--version>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:34
msgid "Show version number and exit."
msgstr ""

#. type: SH
#: data/man/l10n-conv.1:34
#, no-wrap
msgid "COMMANDS"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:35
#, no-wrap
msgid "convert"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:37
msgid "Convert between localization file formats."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:40
msgid "B<l10n-conv convert> I<INPUT> [I<OPTIONS>]"
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:40 data/man/l10n-conv.1:74
#, no-wrap
msgid "I<INPUT>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:43
msgid "Input file path, or B<-> for stdin."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:43 data/man/l10n-conv.1:101 data/man/l10n-conv.1:122
#: data/man/l10n-conv.1:141 data/man/l10n-conv.1:162
#, no-wrap
msgid "B<-f>, B<--format> I<FORMAT>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:47
msgid ""
"Input format. Auto-detected from file extension if omitted. Required when "
"reading from stdin."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:47
#, no-wrap
msgid "B<--to> I<FORMAT>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:51
msgid ""
"Output format. Required unless B<-o> specifies a file with a recognizable "
"extension."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:51 data/man/l10n-conv.1:77 data/man/l10n-conv.1:98
#, no-wrap
msgid "B<-o>, B<--output> I<FILE>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:54
msgid "Output file. Use B<-> for stdout."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:54 data/man/l10n-conv.1:80 data/man/l10n-conv.1:104
#, no-wrap
msgid "B<--dry-run>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:57
msgid "Show what would be done without writing files."
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:57
#, no-wrap
msgid "B<--batch>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:60
msgid "Process all files in a directory recursively."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:62 data/man/l10n-conv.1:85 data/man/l10n-conv.1:109
#: data/man/l10n-conv.1:127 data/man/l10n-conv.1:148 data/man/l10n-conv.1:167
#: data/man/l10n-conv.1:178
msgid "Example:"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:67
#, no-wrap
msgid ""
"l10n-conv convert messages.po --to xliff -o messages.xlf\n"
"l10n-conv convert -f po --to json -o strings.json E<lt> input.po\n"
"l10n-conv convert translations/ --to po -o output/ --batch\n"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:69
#, no-wrap
msgid "compile"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:71
msgid ""
"Compile localization files to binary formats (.po\\[u2192].mo, .ts\\[u2192]."
"qm)."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:74
msgid "B<l10n-conv compile> I<INPUT> B<-o> I<OUTPUT>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:77
msgid "Input file to compile."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:80
msgid "Output file path. Required."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:83
msgid "Show what would be done without writing."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:88
#, no-wrap
msgid "l10n-conv compile po/sv.po -o locale/sv/LC_MESSAGES/app.mo\n"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:90
#, no-wrap
msgid "extract"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:92
msgid "Extract translatable strings from source code files."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:95
msgid "B<l10n-conv extract> I<SOURCE_DIR> B<-o> I<OUTPUT> [I<OPTIONS>]"
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:95
#, no-wrap
msgid "I<SOURCE_DIR>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:98
msgid "Directory containing source code to scan."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:101
msgid "Output file for extracted strings. Required."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:104
msgid "Output format. Default: po."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:107
msgid "Show what would be extracted without writing."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:112
#, no-wrap
msgid "l10n-conv extract src/ -o po/messages.pot\n"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:114
#, no-wrap
msgid "check"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:116
msgid "Validate a localization file for errors and consistency."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:119
msgid "B<l10n-conv check> I<FILE> [B<-f> I<FORMAT>]"
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:119 data/man/l10n-conv.1:138
#, no-wrap
msgid "I<FILE>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:122
msgid "File to validate."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:125 data/man/l10n-conv.1:144 data/man/l10n-conv.1:165
msgid "File format (auto-detected if omitted)."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:131
#, no-wrap
msgid ""
"l10n-conv check po/sv.po\n"
"l10n-conv check strings.json -f json\n"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:133
#, no-wrap
msgid "stats"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:135
msgid "Show translation statistics for a localization file."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:138
msgid "B<l10n-conv stats> I<FILE> [B<-f> I<FORMAT>]"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:141
msgid "File to analyze."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:146
msgid ""
"Shows: total entries, translated, untranslated, fuzzy, completion percentage."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:152
#, no-wrap
msgid ""
"l10n-conv stats po/sv.po\n"
"  Total: 245, Translated: 230 (93.9%), Fuzzy: 5, Untranslated: 10\n"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:154
#, no-wrap
msgid "diff"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:156
msgid "Compare two localization files and show differences."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:159
msgid "B<l10n-conv diff> I<FILE1> I<FILE2> [B<-f> I<FORMAT>]"
msgstr ""

#. type: TP
#: data/man/l10n-conv.1:159
#, no-wrap
msgid "I<FILE1>, I<FILE2>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:162
msgid "Files to compare."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:170
#, no-wrap
msgid "l10n-conv diff old.po new.po\n"
msgstr ""

#. type: SS
#: data/man/l10n-conv.1:172
#, no-wrap
msgid "formats"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:174
msgid "List all supported file formats and their extensions."
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:176
msgid "B<l10n-conv formats>"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:186
#, no-wrap
msgid ""
"l10n-conv formats\n"
"  po      .po, .pot       GNU gettext\n"
"  xliff   .xlf, .xliff    XLIFF 1.2/2.0\n"
"  ts      .ts             Qt Linguist\n"
"  json    .json           JSON (i18next, Chrome)\n"
"  ...\n"
msgstr ""

#. type: SH
#: data/man/l10n-conv.1:188
#, no-wrap
msgid "SUPPORTED FORMATS"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:192
msgid ""
"PO/POT (GNU gettext), XLIFF 1.2/2.0, TS (Qt Linguist), JSON (i18next, Chrome "
"extensions), YAML, ARB (Flutter/Dart), Properties (Java), Strings/"
"Stringsdict (Apple iOS/macOS), Android XML, PHP arrays, CSV."
msgstr ""

