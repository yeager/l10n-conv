#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:144
#, no-wrap
msgid ""
"l10n-conv convert messages.po --to json -o messages.json\n"
"l10n-conv compile messages.po -o messages.mo\n"
"l10n-conv check translations.xliff\n"
"l10n-conv stats messages.po\n"
"l10n-conv merge base.po update.po -o merged.po\n"
"l10n-conv diff old.po new.po\n"
"l10n-conv init template.pot sv -o sv.po\n"
"l10n-conv formats\n"
msgstr ""

