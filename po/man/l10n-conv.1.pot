#. type: SH
#: data/man/l10n-conv.1:9
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: data/man/l10n-conv.1:11
msgid ""
"B<l10n-conv> is a universal localization file converter, validator, and "
"compiler supporting 16+ formats including Gettext PO/MO, Qt TS, XLIFF, Java "
"Properties, Android XML, iOS Strings, JSON, YAML, CSV/TSV, TMX, TBX, PHP, "
"ARB, Fluent, and Windows RESX."
msgstr ""

