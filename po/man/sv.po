#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "L10N-CONV"
msgstr "L10N-CONV"

#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "February 2026"
msgstr "Februari 2026"

#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "l10n-conv 1.0.4"
msgstr "l10n-conv 1.0.4"

#. type: TH
#: data/man/l10n-conv.1:1
#, no-wrap
msgid "User Commands"
msgstr "Användarkommandon"

#. type: SH
#: data/man/l10n-conv.1:2
#, no-wrap
msgid "NAME"
msgstr "NAMN"

#. type: Plain text
#: data/man/l10n-conv.1:4
msgid ""
"l10n-conv - universal localization file converter, validator, and compiler"
msgstr ""
"l10n-conv – universell filkonverterare för lokalisering, validerare och "
"kompilator"

#. type: SH
#: data/man/l10n-conv.1:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: data/man/l10n-conv.1:7
msgid ""
"B<l10n-conv> [I<GLOBAL-OPTIONS>] I<COMMAND> [I<COMMAND-OPTIONS>] [I<ARGS>]"
msgstr ""
"B<l10n-conv> [I<GLOBALA-FLAGGOR>] I<KOMMANDO> [I<KOMMANDOFLAGGOR>] [I<ARG>]"

#. type: SH
#: data/man/l10n-conv.1:7
#, no-wrap
msgid "DESCRIPTION"
msgstr "BESKRIVNING"

#. type: Plain text
#: data/man/l10n-conv.1:11
msgid ""
"B<l10n-conv> converts between different localization file formats, validates"
" translation files, compiles them to binary formats, extracts translatable "
"strings from source code, and shows translation statistics."
msgstr ""
"B<l10n-conv> konverterar mellan olika lokaliseringsfilformat, validerar "
"översättningsfiler, kompilerar dem till binära format, extraherar "
"översättningsbara strängar från källkoden och visar översättningsstatistik."

#. type: Plain text
#: data/man/l10n-conv.1:15
msgid ""
"Supported formats include PO (gettext), XLIFF, TS (Qt), JSON, YAML, ARB "
"(Flutter/Dart), Properties (Java), Strings (Apple), Android XML, and more."
msgstr ""
"Formater som stöds inkluderar PO (gettext), XLIFF, TS (Qt), JSON, YAML, ARB "
"(Flutter/Dart), Properties (Java), Strings (Apple), Android XML och fler."

#. type: Plain text
#: data/man/l10n-conv.1:18
msgid ""
"Format auto-detection is used when possible; use B<-f>/B<--format> to "
"override."
msgstr ""
"Automatisk formatdetektering används när det är möjligt. Använd "
"B<-f>/B<--format> för att åsidosätta detta."

#. type: SH
#: data/man/l10n-conv.1:18
#, no-wrap
msgid "GLOBAL OPTIONS"
msgstr "GLOBALA FLAGGOR"

#. type: TP
#: data/man/l10n-conv.1:19
#, no-wrap
msgid "B<-j>, B<--json>"
msgstr "B<-j>, B<--json>"

#. type: Plain text
#: data/man/l10n-conv.1:22
msgid "Output results as JSON for all commands."
msgstr "Skriv ut resultaten som JSON för alla kommandon."

#. type: TP
#: data/man/l10n-conv.1:22
#, no-wrap
msgid "B<-q>, B<--quiet>"
msgstr "B<-q>, B<--quiet>"

#. type: Plain text
#: data/man/l10n-conv.1:25
msgid "Suppress non-essential output. Only errors are shown."
msgstr "Undertryck onödig utdata. Endast fel visas."

#. type: TP
#: data/man/l10n-conv.1:25
#, no-wrap
msgid "B<-v>, B<--verbose>"
msgstr "B<-v>, B<--verbose>"

#. type: Plain text
#: data/man/l10n-conv.1:28
msgid "Verbose output with progress details."
msgstr "Utförlig utdata med information om förloppet."

#. type: TP
#: data/man/l10n-conv.1:28
#, no-wrap
msgid "B<--about>"
msgstr "B<--about>"

#. type: Plain text
#: data/man/l10n-conv.1:31
msgid "Show application info (name, version, author, license) and exit."
msgstr ""
"Visa programinformation (namn, version, upphovsperson, licens) och avsluta."

#. type: TP
#: data/man/l10n-conv.1:31
#, no-wrap
msgid "B<--version>"
msgstr "B<--version>"

#. type: Plain text
#: data/man/l10n-conv.1:34
msgid "Show version number and exit."
msgstr "Visa versionsnummer och avsluta."

#. type: SH
#: data/man/l10n-conv.1:34
#, no-wrap
msgid "COMMANDS"
msgstr "KOMMANDON"

#. type: SS
#: data/man/l10n-conv.1:35
#, no-wrap
msgid "convert"
msgstr "convert"

#. type: Plain text
#: data/man/l10n-conv.1:37
msgid "Convert between localization file formats."
msgstr "Konvertera mellan olika lokaliseringsfilformat."

#. type: Plain text
#: data/man/l10n-conv.1:40
msgid "B<l10n-conv convert> I<INPUT> [I<OPTIONS>]"
msgstr "B<l10n-conv convert> I<INDATA> [I<FLAGGOR>]"

#. type: TP
#: data/man/l10n-conv.1:40 data/man/l10n-conv.1:74
#, no-wrap
msgid "I<INPUT>"
msgstr "I<INDATA>"

#. type: Plain text
#: data/man/l10n-conv.1:43
msgid "Input file path, or B<-> for stdin."
msgstr "Inmatningsfilens sökväg, eller B<-> för stdin."

#. type: TP
#: data/man/l10n-conv.1:43 data/man/l10n-conv.1:101 data/man/l10n-conv.1:122
#: data/man/l10n-conv.1:141 data/man/l10n-conv.1:162
#, no-wrap
msgid "B<-f>, B<--format> I<FORMAT>"
msgstr "B<-f>, B<--format> I<FORMAT>"

#. type: Plain text
#: data/man/l10n-conv.1:47
msgid ""
"Input format. Auto-detected from file extension if omitted. Required when "
"reading from stdin."
msgstr ""
"Inmatningsformat. Detekteras automatiskt från filändelsen om det utelämnas. "
"Krävs vid läsning från stdin."

#. type: TP
#: data/man/l10n-conv.1:47
#, no-wrap
msgid "B<--to> I<FORMAT>"
msgstr "B<--to> I<FORMAT>"

#. type: Plain text
#: data/man/l10n-conv.1:51
msgid ""
"Output format. Required unless B<-o> specifies a file with a recognizable "
"extension."
msgstr ""
"Utdataformat. Krävs om inte B<-o> anger en fil med en känd filändelse."

#. type: TP
#: data/man/l10n-conv.1:51 data/man/l10n-conv.1:77 data/man/l10n-conv.1:98
#, no-wrap
msgid "B<-o>, B<--output> I<FILE>"
msgstr "B<-o>, B<--output> I<FIL>"

#. type: Plain text
#: data/man/l10n-conv.1:54
msgid "Output file. Use B<-> for stdout."
msgstr "Utdatafil. Använd B<-> för stdout."

#. type: TP
#: data/man/l10n-conv.1:54 data/man/l10n-conv.1:80 data/man/l10n-conv.1:104
#, no-wrap
msgid "B<--dry-run>"
msgstr "B<--dry-run>"

#. type: Plain text
#: data/man/l10n-conv.1:57
msgid "Show what would be done without writing files."
msgstr "Visa vad som skulle göras utan att skriva filer."

#. type: TP
#: data/man/l10n-conv.1:57
#, no-wrap
msgid "B<--batch>"
msgstr "B<--batch>"

#. type: Plain text
#: data/man/l10n-conv.1:60
msgid "Process all files in a directory recursively."
msgstr "Bearbeta alla filer i en katalog rekursivt."

#. type: Plain text
#: data/man/l10n-conv.1:62 data/man/l10n-conv.1:85 data/man/l10n-conv.1:109
#: data/man/l10n-conv.1:127 data/man/l10n-conv.1:148 data/man/l10n-conv.1:167
#: data/man/l10n-conv.1:178
msgid "Example:"
msgstr "Exempel:"

#. type: Plain text
#: data/man/l10n-conv.1:67
#, no-wrap
msgid ""
"l10n-conv convert messages.po --to xliff -o messages.xlf\n"
"l10n-conv convert -f po --to json -o strings.json E<lt> input.po\n"
"l10n-conv convert translations/ --to po -o output/ --batch\n"
msgstr ""
"l10n-conv convert messages.po --to xliff -o messages.xlf\n"
"l10n-conv convert -f po --to json -o strings.json E<lt> input.po\n"
"l10n-conv convert translations/ --to po -o output/ --batch\n"

#. type: SS
#: data/man/l10n-conv.1:69
#, no-wrap
msgid "compile"
msgstr "compile"

#. type: Plain text
#: data/man/l10n-conv.1:71
msgid ""
"Compile localization files to binary formats (.po\\[u2192].mo, "
".ts\\[u2192].qm)."
msgstr ""
"Kompilera lokaliseringsfiler till binära format (.po\\[u2192].mo, "
".ts\\[u2192].qm)."

#. type: Plain text
#: data/man/l10n-conv.1:74
msgid "B<l10n-conv compile> I<INPUT> B<-o> I<OUTPUT>"
msgstr "B<l10n-conv compile> I<INDATA> B<-o> I<UTDATA>"

#. type: Plain text
#: data/man/l10n-conv.1:77
msgid "Input file to compile."
msgstr "Inmatningsfil att kompilera."

#. type: Plain text
#: data/man/l10n-conv.1:80
msgid "Output file path. Required."
msgstr "Utdatafilens sökväg. Obligatoriskt."

#. type: Plain text
#: data/man/l10n-conv.1:83
msgid "Show what would be done without writing."
msgstr "Visa vad som skulle göras utan att skriva."

#. type: Plain text
#: data/man/l10n-conv.1:88
#, no-wrap
msgid "l10n-conv compile po/sv.po -o locale/sv/LC_MESSAGES/app.mo\n"
msgstr "l10n-conv compile po/sv.po -o locale/sv/LC_MESSAGES/app.mo\n"

#. type: SS
#: data/man/l10n-conv.1:90
#, no-wrap
msgid "extract"
msgstr "extract"

#. type: Plain text
#: data/man/l10n-conv.1:92
msgid "Extract translatable strings from source code files."
msgstr "Extrahera översättningsbara strängar från källkodsfiler."

#. type: Plain text
#: data/man/l10n-conv.1:95
msgid "B<l10n-conv extract> I<SOURCE_DIR> B<-o> I<OUTPUT> [I<OPTIONS>]"
msgstr "B<l10n-conv extract> I<KÄLLKATALOG> B<-o> I<UTDATA> [I<FLAGGOR>]"

#. type: TP
#: data/man/l10n-conv.1:95
#, no-wrap
msgid "I<SOURCE_DIR>"
msgstr "I<KÄLLKATALOG>"

#. type: Plain text
#: data/man/l10n-conv.1:98
msgid "Directory containing source code to scan."
msgstr "Katalog som innehåller källkod att söka igenom."

#. type: Plain text
#: data/man/l10n-conv.1:101
msgid "Output file for extracted strings. Required."
msgstr "Utdatafil för extraherade strängar. Obligatoriskt."

#. type: Plain text
#: data/man/l10n-conv.1:104
msgid "Output format. Default: po."
msgstr "Utdataformat. Standard: po."

#. type: Plain text
#: data/man/l10n-conv.1:107
msgid "Show what would be extracted without writing."
msgstr "Visa vad som skulle extraheras utan att skriva."

#. type: Plain text
#: data/man/l10n-conv.1:112
#, no-wrap
msgid "l10n-conv extract src/ -o po/messages.pot\n"
msgstr "l10n-conv extract src/ -o po/messages.pot\n"

#. type: SS
#: data/man/l10n-conv.1:114
#, no-wrap
msgid "check"
msgstr "check"

#. type: Plain text
#: data/man/l10n-conv.1:116
msgid "Validate a localization file for errors and consistency."
msgstr "Validera att lokaliseringsfilen är felfri och konsekvent."

#. type: Plain text
#: data/man/l10n-conv.1:119
msgid "B<l10n-conv check> I<FILE> [B<-f> I<FORMAT>]"
msgstr "B<l10n-conv check> I<FIL> [B<-f> I<FORMAT>]"

#. type: TP
#: data/man/l10n-conv.1:119 data/man/l10n-conv.1:138
#, no-wrap
msgid "I<FILE>"
msgstr "I<FIL>"

#. type: Plain text
#: data/man/l10n-conv.1:122
msgid "File to validate."
msgstr "Fil att validera."

#. type: Plain text
#: data/man/l10n-conv.1:125 data/man/l10n-conv.1:144 data/man/l10n-conv.1:165
msgid "File format (auto-detected if omitted)."
msgstr "Filformat (detekteras automatiskt om det utelämnas)."

#. type: Plain text
#: data/man/l10n-conv.1:131
#, no-wrap
msgid ""
"l10n-conv check po/sv.po\n"
"l10n-conv check strings.json -f json\n"
msgstr ""
"l10n-conv check po/sv.po\n"
"l10n-conv check strings.json -f json\n"

#. type: SS
#: data/man/l10n-conv.1:133
#, no-wrap
msgid "stats"
msgstr "stats"

#. type: Plain text
#: data/man/l10n-conv.1:135
msgid "Show translation statistics for a localization file."
msgstr "Visa översättningsstatistik för en lokaliseringsfil."

#. type: Plain text
#: data/man/l10n-conv.1:138
msgid "B<l10n-conv stats> I<FILE> [B<-f> I<FORMAT>]"
msgstr "B<l10n-conv stats> I<FIL> [B<-f> I<FORMAT>]"

#. type: Plain text
#: data/man/l10n-conv.1:141
msgid "File to analyze."
msgstr "Fil att analysera."

#. type: Plain text
#: data/man/l10n-conv.1:146
msgid ""
"Shows: total entries, translated, untranslated, fuzzy, completion "
"percentage."
msgstr ""
"Visar: totalt antal poster, översatta, oöversatta, luddiga, procentuell "
"fullständighet."

#. type: Plain text
#: data/man/l10n-conv.1:152
#, no-wrap
msgid ""
"l10n-conv stats po/sv.po\n"
"  Total: 245, Translated: 230 (93.9%), Fuzzy: 5, Untranslated: 10\n"
msgstr ""
"l10n-conv stats po/sv.po\n"
"  Totatl: 245, Översatta: 230 (93.9%), Luddiga: 5, Oöversatta: 10\n"

#. type: SS
#: data/man/l10n-conv.1:154
#, no-wrap
msgid "diff"
msgstr "diff"

#. type: Plain text
#: data/man/l10n-conv.1:156
msgid "Compare two localization files and show differences."
msgstr "Jämför två lokaliseringsfiler och visa skillnaderna."

#. type: Plain text
#: data/man/l10n-conv.1:159
msgid "B<l10n-conv diff> I<FILE1> I<FILE2> [B<-f> I<FORMAT>]"
msgstr "B<l10n-conv diff> I<FIL1> I<FIL2> [B<-f> I<FORMAT>]"

#. type: TP
#: data/man/l10n-conv.1:159
#, no-wrap
msgid "I<FILE1>, I<FILE2>"
msgstr "I<FIL1>, I<FIL2>"

#. type: Plain text
#: data/man/l10n-conv.1:162
msgid "Files to compare."
msgstr "Filer att jämföra."

#. type: Plain text
#: data/man/l10n-conv.1:170
#, no-wrap
msgid "l10n-conv diff old.po new.po\n"
msgstr "l10n-conv diff gammal.po ny.po\n"

#. type: SS
#: data/man/l10n-conv.1:172
#, no-wrap
msgid "formats"
msgstr "formats"

#. type: Plain text
#: data/man/l10n-conv.1:174
msgid "List all supported file formats and their extensions."
msgstr "Lista alla filformat som stöds och deras filändelser."

#. type: Plain text
#: data/man/l10n-conv.1:176
msgid "B<l10n-conv formats>"
msgstr "B<l10n-conv formats>"

#. type: Plain text
#: data/man/l10n-conv.1:186
#, no-wrap
msgid ""
"l10n-conv formats\n"
"  po      .po, .pot       GNU gettext\n"
"  xliff   .xlf, .xliff    XLIFF 1.2/2.0\n"
"  ts      .ts             Qt Linguist\n"
"  json    .json           JSON (i18next, Chrome)\n"
"  ...\n"
msgstr ""
"l10n-conv formats\n"
"  po      .po, .pot       GNU gettext\n"
"  xliff   .xlf, .xliff    XLIFF 1.2/2.0\n"
"  ts      .ts             Qt Linguist\n"
"  json    .json           JSON (i18next, Chrome)\n"
"  ...\n"

#. type: SH
#: data/man/l10n-conv.1:188
#, no-wrap
msgid "SUPPORTED FORMATS"
msgstr "FORMAT SOM STÖDS"

#. type: Plain text
#: data/man/l10n-conv.1:192
msgid ""
"PO/POT (GNU gettext), XLIFF 1.2/2.0, TS (Qt Linguist), JSON (i18next, Chrome"
" extensions), YAML, ARB (Flutter/Dart), Properties (Java), "
"Strings/Stringsdict (Apple iOS/macOS), Android XML, PHP arrays, CSV."
msgstr ""
"PO/POT (GNU gettext), XLIFF 1.2/2.0, TS (Qt Linguist), JSON (i18next, "
"Chrome-tillägg), YAML, ARB (Flutter/Dart), Properties (Java), "
"Strings/Stringsdict (Apple iOS/macOS), Android XML, PHP-arrayer, CSV."

#. type: SH
#: data/man/l10n-conv.1:192
#, no-wrap
msgid "EXIT STATUS"
msgstr "AVSLUTSSTATUS"

#. type: TP
#: data/man/l10n-conv.1:193
#, no-wrap
msgid "B<0>"
msgstr "B<0>"

#. type: Plain text
#: data/man/l10n-conv.1:196
msgid "Success (conversion completed, file valid, no differences)."
msgstr "Lyckades (konvertering slutförd, filen giltig, inga skillnader)."

#. type: TP
#: data/man/l10n-conv.1:196
#, no-wrap
msgid "B<1>"
msgstr "B<1>"

#. type: Plain text
#: data/man/l10n-conv.1:199
msgid ""
"Errors found (validation failures, conversion errors, differences found)."
msgstr ""
"Fel upptäcktes (valideringsfel, konverteringsfel, skillnader upptäckta)."

#. type: TP
#: data/man/l10n-conv.1:199
#, no-wrap
msgid "B<2>"
msgstr "B<2>"

#. type: Plain text
#: data/man/l10n-conv.1:202
msgid ""
"Usage error (unknown format, file not found, missing required options)."
msgstr ""
"Användningsfel (okänt format, filen hittades inte, nödvändiga flaggor "
"saknas)."

#. type: SH
#: data/man/l10n-conv.1:202
#, no-wrap
msgid "SEE ALSO"
msgstr "SE ÄVEN"

#. type: Plain text
#: data/man/l10n-conv.1:207
msgid "B<l10n-lint>(1), B<po-translate>(1), B<msgfmt>(1), B<msgunfmt>(1)"
msgstr "B<l10n-lint>(1), B<po-translate>(1), B<msgfmt>(1), B<msgunfmt>(1)"

#. type: SH
#: data/man/l10n-conv.1:207
#, no-wrap
msgid "AUTHOR"
msgstr "UPPHOVSPERSON"

#. type: Plain text
#: data/man/l10n-conv.1:209
msgid "Daniel Nylander E<lt>daniel@danielnylander.seE<gt>"
msgstr "Daniel Nylander E<lt>daniel@danielnylander.seE<gt>"

#. type: SH
#: data/man/l10n-conv.1:209
#, no-wrap
msgid "BUGS"
msgstr "BUGGAR"

#. type: Plain text
#: data/man/l10n-conv.1:211
msgid "Report bugs at: https://github.com/yeager/l10n-conv/issues"
msgstr "Rapportera buggar på: https://github.com/yeager/l10n-conv/issues"

#. type: SH
#: data/man/l10n-conv.1:211
#, no-wrap
msgid "COPYRIGHT"
msgstr "UPPHOVSRÄTT"

